; Copy this file to secrets.ini (gitignored) and fill in your own values:
;
;   cp secrets.ini.example secrets.ini
;
; platformio.ini pulls secrets.ini in via `extra_configs` and turns this
; section into compiler -D flags, so no C++ header needs to be hand-edited
; per device.
[secrets]
build_flags =
    -D WIFI_SSID='"CHANGE_ME"'
    -D WIFI_PASSWORD='"CHANGE_ME"'
    ; No trailing slash. Local testing example: http://192.168.1.50:8080
    -D API_BASE_URL='"http://CHANGE_ME:8080"'
    -D API_AUTH_TOKEN='"CHANGE_ME"'
    ; POSIX TZ string (handles DST automatically). Europe/Madrid shown here,
    ; matching the TZ my-assistant itself is configured with.
    -D TZ_STRING='"CET-1CEST,M3.5.0,M10.5.0/3"'
    ;
    ; Optional, testing only -- uncomment to make a successful cycle sleep
    ; for this many seconds instead of the real hourly schedule, so you can
    ; watch several full wake/fetch/draw/sleep cycles in a couple of
    ; minutes instead of waiting an hour each. Comment out again (and
    ; reflash) before leaving the device running unattended.
    ; -D DEBUG_SLEEP_OVERRIDE_SEC=30
